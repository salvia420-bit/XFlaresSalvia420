//@version=6
indicator("X-Class Solar Flare Tracker", shorttitle="X-Flares", overlay=false)

// ════════════════════════════════════════════════════════════════════════════
// 📊 ABOUT THIS SCRIPT
// ════════════════════════════════════════════════════════════════════════════
// This script tracks X-class solar flares - the most powerful classification
// of solar flares based on X-ray intensity measured by GOES satellites.
//
// IMPORTANT NOTES:
// • X-class flare classification began in 1975 with GOES satellites
// • Reliable public data exists from 1996-present (Solar Cycle 23 onwards)
// • This dataset includes major X-class flares (X5+) and significant events
// • The script can be easily updated with new flares as they occur
//
// DATA SOURCES:
// • NOAA Space Weather Prediction Center (SWPC)
// • SpaceWeatherLive.com historical database
// • NASA Solar Dynamics Observatory (SDO)
// ════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// 🎛️ USER INPUTS
// ══════════════════════════════════════════════════════════════════
plotStyle = input.string("Columns", "Display Style", options=["Columns", "Histogram", "Line"], group="Display Options")
minMagnitude = input.float(1.0, "Minimum X-Class Magnitude to Display", minval=1.0, maxval=50.0, step=0.1, group="Display Options")
showLabels = input.bool(true, "Show Flare Magnitude Labels", group="Display Options")
showTable = input.bool(true, "Show Flare Statistics Table", group="Display Options")
tablePosition = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Display Options")
showZeroLine = input.bool(true, "Show Zero Baseline", group="Display Options")

// Color scheme
colorX1to5 = input.color(color.yellow, "X1-X5 Flares", group="Colors")
colorX5to10 = input.color(color.orange, "X5-X10 Flares", group="Colors")
colorX10to20 = input.color(color.red, "X10-X20 Flares", group="Colors")
colorX20plus = input.color(color.fuchsia, "X20+ Flares (Extreme)", group="Colors")

// ══════════════════════════════════════════════════════════════════
// 📅 SOLAR FLARE DATABASE
// ══════════════════════════════════════════════════════════════════
// Format: [Unix Timestamp (milliseconds), Magnitude, "Description"]
//
// HOW TO UPDATE WITH NEW FLARES:
// 1. Get the flare date/time (UTC) from NOAA SWPC or SpaceWeatherLive.com
// 2. Convert to Unix timestamp in milliseconds (use: https://currentmillis.com)
// 3. Add new entry to the array below following the format
// 4. Keep entries in chronological order (recommended but not required)
//
// Example: For a flare on January 1, 2025 at 12:00 UTC with magnitude X5.5:
// array.push(flareTimes, 1735732800000)
// array.push(flareMags, 5.5)
// array.push(flareDescs, "2025-01-01 X5.5")
// ══════════════════════════════════════════════════════════════════

var flareTimes = array.new<float>()
var flareMags = array.new<float>()
var flareDescs = array.new<string>()

if barstate.isfirst
