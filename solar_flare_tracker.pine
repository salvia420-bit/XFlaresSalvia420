// Modified by AI: Optimized Performance, Added 1859-2025 Data, and Log Scale.

//@version=6
indicator("☀️ Solar Flare & Geomagnetic Storm Tracker (1859-2025)", shorttitle="Solar Flares", overlay=false, precision=1)

// ════════════════════════════════════════════════════════════════════════════
// ⚙️ CONFIGURATION
// ════════════════════════════════════════════════════════════════════════════

grp_disp    = "Display Settings"
plotStyle   = input.string("Columns", "Plot Style", options=["Columns", "Histogram", "Line", "Area", "Circles"], group=grp_disp)
minMag      = input.float(1.0, "Min Magnitude", minval=0.1, maxval=50.0, step=0.5, group=grp_disp)
useLog      = input.bool(false, "Logarithmic Scale", group=grp_disp, tooltip="Useful to compare the massive Carrington event vs modern flares.")
showLabels  = input.bool(true, "Show Labels", group=grp_disp)
showCycles  = input.bool(true, "Show Solar Cycles", group=grp_disp, tooltip="Background highlights for Cycle 23, 24, 25")

grp_filter  = "Data Filters"
showHist    = input.bool(true, "Show Historical (Pre-1975)", group=grp_filter)
showCarr    = input.bool(true, "Show 1859 Carrington Event", group=grp_filter)

grp_stats   = "Dashboard"
showTable   = input.bool(true, "Show Stats Table", group=grp_stats)
tablePos    = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_stats)

grp_col     = "Colors"
c_x1        = input.color(color.new(color.yellow, 20), "X1-X5 (Moderate)", group=grp_col)
c_x5        = input.color(color.new(color.orange, 20), "X5-X10 (Strong)", group=grp_col)
c_x10       = input.color(color.new(color.red, 10), "X10-X20 (Severe)", group=grp_col)
c_x20       = input.color(color.new(color.fuchsia, 0), "X20+ (Extreme)", group=grp_col)
c_hist      = input.color(color.new(color.aqua, 30), "Historical (Est)", group=grp_col)

// ══════════════════════════════════════════════════════════════════
// 🏗️ DATA STRUCTURE & STORAGE
// ══════════════════════════════════════════════════════════════════

// We use a User Defined Type for cleaner array management
type Event
    int     ts      // Timestamp
    float   mag     // Magnitude
    string  desc    // Description
    bool    isHist  // Is Historical?

// Initialize arrays once
var events = array.new<Event>()

add(y, m, d, mag, desc, isHist) =>
    array.push(events, Event.new(timestamp(y, m, d, 0, 0), mag, desc, isHist))

if barstate.isfirst
    // 📜 1859 - The Carrington Event
    add(1859, 9, 1, 45.0, "1859-09-01 ~X45 Carrington Event", true)

    // 📜 1900-1975 Historical (Geomagnetic Estimates)
    add(1921, 5, 15, 40.0, "1921-05-15 ~X40 NY Railroad Storm", true)
    add(1940, 3, 24, 15.0, "1940-03-24 ~X15 Major Storm", true)
    add(1956, 2, 23, 12.0, "1956-02-23 ~X12 Solar Event", true)
    add(1959, 7, 15, 10.0, "1959-07-15 ~X10 Geomag Storm", true)
    add(1960, 11, 13, 8.0, "1960-11-13 ~X8 Solar Event", true)
    add(1972, 8, 4, 20.0, "1972-08-04 ~X20 Fastest CME", true)
    
    // 🔥 1976-1996 (Cycle 21 & 22)
    add(1978, 7, 11, 15.0, "X15.0", false)
    add(1982, 6, 6, 12.0, "X12.0", false)
    add(1982, 12, 15, 12.9, "X12.9", false)
    add(1984, 4, 24, 13.0, "X13.0", false)
    add(1989, 3, 6, 15.0, "X15.0", false)
    add(1989, 3, 13, 15.0, "1989-03-13 X15.0 Quebec Blackout", false)
    add(1989, 8, 16, 20.0, "1989-08-16 X20.0", false)
    add(1991, 6, 1, 12.0, "1991-06-01 X12.0", false)
    add(1991, 6, 4, 12.0, "1991-06-04 X12.0", false)
    add(1991, 6, 6, 12.0, "1991-06-06 X12.0", false)
    add(1991, 6, 11, 12.0, "1991-06-11 X12.0", false)
    add(1991, 6, 15, 12.0, "1991-06-15 X12.0", false)

    // ⚡ 1997-2019 (Cycle 23 & 24)
    add(1997, 11, 6, 9.4, "X9.4", false)
    add(2000, 7, 14, 5.7, "2000-07-14 X5.7 Bastille Day", false)
    add(2001, 4, 2, 20.0, "2001-04-02 X20.0", false)
    add(2001, 4, 15, 14.4, "X14.4", false)
    add(2003, 10, 28, 17.2, "2003-10-28 X17.2 Halloween", false)
    add(2003, 11, 4, 28.0, "2003-11-04 X28+ (Est X45)", false)
    add(2005, 9, 7, 17.0, "2005-09-07 X17.0", false)
    add(2006, 12, 5, 9.0, "X9.0", false)
    add(2011, 8, 9, 6.9, "X6.9", false)
    add(2012, 3, 7, 5.4, "X5.4", false)
    add(2017, 9, 6, 9.3, "2017-09-06 X9.3", false)
    add(2017, 9, 10, 8.2, "2017-09-10 X8.2", false)

    // ☀️ 2020-2023 (Cycle 25 Rise)
    add(2021, 7, 3, 1.5, "Cycle 25 First X", false)
    add(2022, 4, 20, 2.2, "X2.2", false)
    add(2023, 12, 31, 5.0, "2023-12-31 X5.0", false)

    // 🌟 2024 (Record Breaking Year)
    add(2024, 1, 1, 5.0, "2024-01-01 X5.0", false)
    add(2024, 2, 22, 6.3, "2024-02-22 X6.3", false)
    add(2024, 5, 10, 5.8, "X5.8 G5 Storm", false)
    add(2024, 5, 14, 8.7, "2024-05-14 X8.7", false)
    add(2024, 10, 1, 7.1, "2024-10-01 X7.1", false)
    add(2024, 10, 3, 9.0, "2024-10-03 X9.0 (Cycle Peak)", false)
    add(2024, 10, 24, 3.3, "X3.3", false)
    add(2024, 12, 29, 1.1, "X1.1", false)

    // 🔮 2025 (Based on current records/projections)
    add(2025, 1, 4, 1.9, "2025-01-04 X1.9", false)
    add(2025, 5, 14, 2.7, "X2.7", false)
    add(2025, 11, 11, 5.1, "2025-11-11 X5.1 (Nov Storm)", false)
    add(2025, 11, 14, 4.0, "X4.0", false)
    add(2025, 12, 1, 1.9, "X1.9", false)


// ══════════════════════════════════════════════════════════════════
// ⚡ OPTIMIZED CALCULATION (POINTER LOGIC)
// ══════════════════════════════════════════════════════════════════

// Tracks where we are in the event list so we don't loop through history every bar
var int ptr = 0

float barMag = 0.0
string barDesc = ""
color barColor = na
int eventCount = 0

// Define the time range of the current bar
int t_start = time
int t_end = time_close

// Loop through events starting from our pointer
// Stop when we hit an event that is in the future relative to this bar
while ptr < array.size(events)
    Event e = array.get(events, ptr)
    
    if e.ts >= t_end
        // Event is in the future for this bar
        break
    else if e.ts < t_start
        // Event is older than this bar (we missed it or it was in a gap)
        ptr += 1
    else
        // ✅ Event is INSIDE this bar (t_start <= ts < t_end)
        // Apply Filters
        bool visible = true
        if e.isHist and not showHist
            visible := false
        if e.mag == 45.0 and not showCarr
            visible := false
        if e.mag < minMag
            visible := false
            
        if visible
            // Logic for Weekly/Monthly charts: Track the MAX magnitude
            barMag := math.max(barMag, e.mag)
            
            // Accumulate descriptions if multiple events
            if eventCount == 0
                barDesc := e.desc
                barColor := e.isHist ? c_hist : (e.mag >= 20 ? c_x20 : e.mag >= 10 ? c_x10 : e.mag >= 5 ? c_x5 : c_x1)
            else
                barDesc := barDesc + "\n" + e.desc
                // Upgrade color if a stronger flare was added
                if e.mag >= 20 and not e.isHist 
                    barColor := c_x20
            
            eventCount += 1
        
        // Move to next event to see if it also falls in this bar
        ptr += 1


// ══════════════════════════════════════════════════════════════════
// 🎨 VISUALIZATION
// ══════════════════════════════════════════════════════════════════

// Solar Cycle Background
isC23 = time >= timestamp(1996, 8, 1, 0, 0) and time < timestamp(2008, 12, 1, 0, 0)
isC24 = time >= timestamp(2008, 12, 1, 0, 0) and time < timestamp(2019, 12, 1, 0, 0)
isC25 = time >= timestamp(2019, 12, 1, 0, 0)
bgcolor(showCycles and isC23 ? color.new(color.blue, 95) : na, title="Cycle 23")
bgcolor(showCycles and isC24 ? color.new(color.gray, 95) : na, title="Cycle 24")
bgcolor(showCycles and isC25 ? color.new(color.orange, 95) : na, title="Cycle 25")

// Log Scale Handling
// If Log scale is on, we map X1 to 1.0, X10 to 2.0, X40 to ~2.6
valToPlot = useLog and barMag > 0 ? math.log10(barMag) + 1 : barMag

// Plot Style
style = plotStyle == "Columns" ? plot.style_columns : plotStyle == "Histogram" ? plot.style_histogram : plotStyle == "Area" ? plot.style_area : plotStyle == "Circles" ? plot.style_circles : plot.style_line
plot(valToPlot > 0 ? valToPlot : na, title="Magnitude", color=barColor, style=style, linewidth=2)

// Smart Labels
if showLabels and barMag > 0
    txt = eventCount > 1 ? str.tostring(eventCount) + " Events\n(Max X" + str.tostring(barMag) + ")" : barDesc + "\n(X" + str.tostring(barMag) + ")"
    label.new(bar_index, valToPlot, text=txt, style=label.style_label_up, color=barColor, textcolor=color.white, size=size.small, tooltip=barDesc)

// Reference Lines (Adjusted for Log Scale)
h5 = useLog ? math.log10(5)+1 : 5
h10 = useLog ? math.log10(10)+1 : 10
h20 = useLog ? math.log10(20)+1 : 20

hline(useLog ? math.log10(1)+1 : 0, "Baseline", color.gray)
hline(h5, "X5 Threshold", color=color.new(c_x5, 50), linestyle=hline.style_dotted)
hline(h10, "X10 Threshold", color=color.new(c_x10, 50), linestyle=hline.style_dotted)
hline(h20, "X20 Threshold", color=color.new(c_x20, 50), linestyle=hline.style_dotted)

// ══════════════════════════════════════════════════════════════════
// 📊 DASHBOARD
// ══════════════════════════════════════════════════════════════════

if showTable and barstate.islast
    // Calculate stats (Only iterating once at end)
    int t_ev = 0
    int cnt_x20 = 0
    int cnt_x10 = 0
    int cnt_x5 = 0
    float max_m = 0.0
    string max_d = ""
    int last_ts = 0

    for i = 0 to array.size(events) - 1
        Event e = array.get(events, i)
        bool inc = true
        if e.isHist and not showHist 
            inc := false
        if e.mag == 45.0 and not showCarr
            inc := false
        
        if inc
            t_ev += 1
            if e.mag >= 20 
                cnt_x20 += 1
            else if e.mag >= 10
                cnt_x10 += 1
            else if e.mag >= 5
                cnt_x5 += 1
            
            if e.mag > max_m
                max_m := e.mag
                max_d := e.desc
            
            if e.ts > last_ts
                last_ts := e.ts

    // Setup Table
    string pos = tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
    var tbl = table.new(pos, 2, 7, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1, bgcolor=color.new(color.black, 50))
    
    // Draw
    table.cell(tbl, 0, 0, "☀️ SOLAR MONITOR", bgcolor=color.new(color.orange, 20), text_color=color.white, text_size=size.normal)
    table.merge_cells(tbl, 0, 0, 1, 0)
    
    table.cell(tbl, 0, 1, "Total Events", text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 1, str.tostring(t_ev), text_color=color.white)
    
    table.cell(tbl, 0, 2, "Extreme (X20+)", text_color=c_x20, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(cnt_x20), text_color=c_x20)
    
    table.cell(tbl, 0, 3, "Severe (X10+)", text_color=c_x10, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(cnt_x10), text_color=c_x10)
    
    table.cell(tbl, 0, 4, "Strong (X5+)", text_color=c_x5, text_halign=text.align_left)
    table.cell(tbl, 1, 4, str.tostring(cnt_x5), text_color=c_x5)
    
    table.cell(tbl, 0, 5, "Max Recorded", text_color=color.gray, text_halign=text.align_left)
    table.cell(tbl, 1, 5, "X" + str.tostring(max_m), text_color=c_x20)

    days = (time - last_ts) / 86400000
    table.cell(tbl, 0, 6, "Days Since Last", text_color=color.gray, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(math.round(days)) + "d", text_color=days < 30 ? color.red : color.green)

// 🚨 ALERTS
alertcondition(barMag >= 1.0, title="X-Class Flare", message="Solar Flare Detected: {{plot('Magnitude')}}")
alertcondition(barMag >= 10.0, title="Major Solar Storm", message="Major X10+ Event Detected")
