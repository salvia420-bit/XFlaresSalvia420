    // 🆕 TO ADD NEW FLARES, INSERT THEM HERE:
    // Example format:
    // array.push(flareTimes, TIMESTAMP), array.push(flareMags, MAGNITUDE), array.push(flareDescs, "YYYY-MM-DD XMAG")

    // ════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════
// 🎨 VISUALIZATION LOGIC
// ══════════════════════════════════════════════════════════════════

// Current bar timestamp (in milliseconds)
currentTime = time

// Variables to track flare on current bar
var float flareMagnitude = 0.0
var string flareLabel = ""
var color flareColor = na

// Check if there's a flare on this timestamp
for i = 0 to array.size(flareTimes) - 1
    flareTime = array.get(flareTimes, i)
    flareMag = array.get(flareMags, i)
    flareDesc = array.get(flareDescs, i)

    // Check if flare occurs on this day (within 24 hours)
    timeDiff = math.abs(currentTime - flareTime)
    if timeDiff < 86400000 and flareMag >= minMagnitude  // 86400000ms = 24 hours
        flareMagnitude := flareMag
        flareLabel := flareDesc

        // Assign color based on magnitude
        flareColor := flareMag >= 20 ? colorX20plus :
                     flareMag >= 10 ? colorX10to20 :
                     flareMag >= 5 ? colorX5to10 : colorX1to5
        break

// If no flare found, reset to zero
if na(flareColor)
    flareMagnitude := 0.0
    flareLabel := ""

// Determine plot style
plotStyleValue = plotStyle == "Columns" ? plot.style_columns :
                 plotStyle == "Histogram" ? plot.style_histogram :
                 plot.style_line

// Plot the magnitude values
plot(flareMagnitude, title="Solar Flare Magnitude", color=flareColor, style=plotStyleValue, linewidth=2)

// Plot zero baseline
hline(0, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_solid, linewidth=1, display=showZeroLine ? display.all : display.none)

// Add reference lines for magnitude thresholds
hline(5, "X5", color=color.new(colorX5to10, 70), linestyle=hline.style_dotted, linewidth=1)
hline(10, "X10", color=color.new(colorX10to20, 70), linestyle=hline.style_dotted, linewidth=1)
hline(20, "X20", color=color.new(colorX20plus, 70), linestyle=hline.style_dotted, linewidth=1)

// Add labels with flare details
if showLabels and flareMagnitude > 0
    label.new(
         bar_index,
         flareMagnitude,
         text=flareLabel,
         style=label.style_label_up,
         color=flareColor,
         textcolor=color.white,
         size=size.small,
         yloc=yloc.price
     )

// ══════════════════════════════════════════════════════════════════
// 📊 STATISTICS TABLE
// ══════════════════════════════════════════════════════════════════

if showTable and barstate.islast
    // Calculate statistics
    totalFlares = array.size(flareTimes)
    countX1to5 = 0
    countX5to10 = 0
    countX10to20 = 0
    countX20plus = 0
    maxFlare = 0.0
    maxFlareDate = ""

    for i = 0 to array.size(flareMags) - 1
        mag = array.get(flareMags, i)
        if mag > maxFlare
            maxFlare := mag
            maxFlareDate := array.get(flareDescs, i)

        if mag >= 20
            countX20plus += 1
        else if mag >= 10
            countX10to20 += 1
        else if mag >= 5
            countX5to10 += 1
        else
            countX1to5 += 1

    // Determine table position
    tablePos = tablePosition == "Top Right" ? position.top_right :
               tablePosition == "Top Left" ? position.top_left :
               tablePosition == "Bottom Right" ? position.bottom_right :
               position.bottom_left

    // Create table
    var table statsTable = table.new(tablePos, 2, 8, border_width=2, border_color=color.gray, frame_width=1, frame_color=color.gray)

    if barstate.islast
        // Header
        table.cell(statsTable, 0, 0, "☀️ X-FLARE TRACKER", text_color=color.white, bgcolor=color.new(color.orange, 0), text_size=size.normal)
        table.merge_cells(statsTable, 0, 0, 1, 0)

        // Data rows
        table.cell(statsTable, 0, 1, "Total X-Flares:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 1, str.tostring(totalFlares), text_color=color.yellow, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 2, "X1-X5:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 2, str.tostring(countX1to5), text_color=colorX1to5, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 3, "X5-X10:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 3, str.tostring(countX5to10), text_color=colorX5to10, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 4, "X10-X20:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 4, str.tostring(countX10to20), text_color=colorX10to20, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 5, "X20+:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 5, str.tostring(countX20plus), text_color=colorX20plus, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 6, "Strongest:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 6, "X" + str.tostring(maxFlare, "#.#"), text_color=colorX20plus, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 7, "Date:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 7, maxFlareDate, text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)

