// ══════════════════════════════════════════════════════════════════
// 🎨 VISUALIZATION LOGIC
// ══════════════════════════════════════════════════════════════════

// Find matching event for current bar
var float magnitude = 0.0
var string label_text = ""
var color bar_color = na
var bool is_historical = false

// Check each event
for i = 0 to array.size(eventTimes) - 1
    eventTime = array.get(eventTimes, i)
    eventMag = array.get(eventMags, i)
    eventDesc = array.get(eventDescs, i)
    eventType = array.get(eventTypes, i)

    // Skip historical events if disabled
    if eventType == "historical" and not showHistoricalEvents
        continue

    // Check if event matches current bar (using dayofyear and year)
    if year(eventTime) == year(time) and month(eventTime) == month(time) and dayofmonth(eventTime) == dayofmonth(time) and eventMag >= minMagnitude
        magnitude := eventMag
        label_text := eventDesc
        is_historical := eventType == "historical"

        // Color assignment
        if is_historical
            bar_color := colorHistorical
        else
            bar_color := eventMag >= 20 ? colorX20plus : eventMag >= 10 ? colorX10to20 : eventMag >= 5 ? colorX5to10 : colorX1to5
        break

// Reset if no match
if na(bar_color)
    magnitude := 0.0
    label_text := ""
    is_historical := false

// Plot style
plotStyleValue = plotStyle == "Columns" ? plot.style_columns :
                 plotStyle == "Histogram" ? plot.style_histogram :
                 plotStyle == "Area" ? plot.style_area :
                 plot.style_line

// Main plot
plot(magnitude, title="Solar Event Magnitude", color=bar_color, style=plotStyleValue, linewidth=2)

// Reference lines
hline(0, "Zero", color=color.new(color.gray, 50), linestyle=hline.style_solid, linewidth=1, display=showZeroLine ? display.all : display.none)
hline(5, "X5", color=color.new(color.orange, 70), linestyle=hline.style_dotted, linewidth=1)
hline(10, "X10", color=color.new(color.red, 70), linestyle=hline.style_dotted, linewidth=1)
hline(20, "X20", color=color.new(color.fuchsia, 70), linestyle=hline.style_dotted, linewidth=1)

// Labels
if showLabels and magnitude > 0
    label.new(bar_index, magnitude, text=label_text, style=label.style_label_up, color=bar_color, textcolor=color.white, size=size.small, yloc=yloc.price)

// ══════════════════════════════════════════════════════════════════
// 📊 STATISTICS TABLE
// ══════════════════════════════════════════════════════════════════

if showTable and barstate.islast
    totalEvents = 0
    historicalCount = 0
    countX1to5 = 0
    countX5to10 = 0
    countX10to20 = 0
    countX20plus = 0
    maxMag = 0.0
    maxDesc = ""

    for i = 0 to array.size(eventMags) - 1
        mag = array.get(eventMags, i)
        evType = array.get(eventTypes, i)

        // Skip historical if disabled
        if evType == "historical" and not showHistoricalEvents
            continue

        totalEvents += 1

        if evType == "historical"
            historicalCount += 1

        if mag > maxMag
            maxMag := mag
            maxDesc := array.get(eventDescs, i)

        if mag >= 20
            countX20plus += 1
        else if mag >= 10
            countX10to20 += 1
        else if mag >= 5
            countX5to10 += 1
        else
            countX1to5 += 1

    tablePos = tablePosition == "Top Right" ? position.top_right :
               tablePosition == "Top Left" ? position.top_left :
               tablePosition == "Bottom Right" ? position.bottom_right : position.bottom_left

    var table statsTable = table.new(tablePos, 2, 9, border_width=2, border_color=color.gray, frame_width=1, frame_color=color.gray)

    if barstate.islast
        table.cell(statsTable, 0, 0, "☀️ SOLAR ACTIVITY TRACKER", text_color=color.white, bgcolor=color.new(color.orange, 0), text_size=size.normal)
        table.merge_cells(statsTable, 0, 0, 1, 0)

        table.cell(statsTable, 0, 1, "Total Events:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 1, str.tostring(totalEvents), text_color=color.yellow, bgcolor=color.new(color.gray, 50))

        if showHistoricalEvents
            table.cell(statsTable, 0, 2, "Historical (Est):", text_color=color.white, bgcolor=color.new(color.gray, 50))
            table.cell(statsTable, 1, 2, str.tostring(historicalCount), text_color=colorHistorical, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 3, "X1-X5:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 3, str.tostring(countX1to5), text_color=colorX1to5, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 4, "X5-X10:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 4, str.tostring(countX5to10), text_color=colorX5to10, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 5, "X10-X20:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 5, str.tostring(countX10to20), text_color=colorX10to20, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 6, "X20+:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 6, str.tostring(countX20plus), text_color=colorX20plus, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 7, "Strongest:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 7, "X" + str.tostring(maxMag, "#.#"), text_color=colorX20plus, bgcolor=color.new(color.gray, 50))

        table.cell(statsTable, 0, 8, "Event:", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(statsTable, 1, 8, maxDesc, text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
